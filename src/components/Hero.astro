---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
}

const { align = 'center', tagline, title } = Astro.props;
---

<div class:list={['hero stack gap-4', align]}>
	<div class="stack gap-2">
		<svg viewBox="0 0 200 20">
			<defs>
			  <linearGradient id="gradient" x1="0" x2="0" y1="0" y2="1">
				<stop offset="5%" stop-color="var(--hero-color-stop-1)"/>
				<stop offset="95%" stop-color="var(--hero-color-stop-2)"/>
			  </linearGradient>
			  <pattern id="wave" x="0" y="-3" width="120" height="20" patternUnits="userSpaceOnUse">
				<path id="wavePath" d="M-40 9 Q-30 7 -20 9 T0 9 T20 9 T40 9 T60 9 T80 9 T100 9 T120 9 V20 H-40z" mask="url(#mask)" fill="url(#gradient)"> 
				  <animateTransform
					  attributeName="transform"
					  begin="0s"
					  dur="4s"
					  type="translate"
					  from="0,0"
					  to="40,0"
					  repeatCount="indefinite" />
				</path>
			  </pattern>
			</defs>
			<text text-anchor="center" x="34" y="15" font-size=var(--text-lg) fill="url(#wave)"  fill-opacity="0.6">{title}</text>
			<text text-anchor="center" x="34" y="15" font-size=var(--text-lg) fill="url(#gradient)" fill-opacity="0.1">{title}</text>
		  </svg>
		{tagline && <p class="tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
	}
	.hero.start {
	text-align: center;
}

	.title,
	.tagline {
		max-width: 37ch;
		margin-inline: auto;
		
	}

	.title {
		font-size: var(--text-3xl);
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}
		.hero.start {
	}

		.start {
			text-align: center;
		}

		.start .title,
		.start .tagline {
	
		}

		.title {
			font-size: var(--text-xl);
		}

		.hero svg {
		width: 100%;
		height: auto;
		max-width: 100%;
		}
	}
</style>
